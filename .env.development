# Loaded in development mode (npm run dev / build:dev). Local dev talks to the TEST Supabase
# (via .env.local), so keep the "TESTMILJÖ" banner on. Supabase vars still come from .env.local.
VITE_APP_ENV="test"
# Test-mode Stripe key (public, same as .env.test). Without it, dev mode would inherit the
