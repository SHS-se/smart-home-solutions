{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Home Solutions private Home Assistant API",
    "version": "1.0.0",
    "description": "Private device client API. Supabase /functions/v1 is a gateway path and is not this contract version."
  },
  "x-shs-versioning": {
    "api_version": 1,
    "supported_snapshot_schema_versions": [5, 6, 7],
    "supported_plan_schema_versions": [5, 6, 7],
    "minimum_snapshot_schema_version": 5,
    "minimum_plan_schema_version": 5
  },
  "servers": [{ "url": "https://{project}.supabase.co/functions/v1" }],
  "paths": {
    "/pair-device": {
      "post": {
        "operationId": "pairDevice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PairDeviceRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paired",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairDeviceResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/integration-status": {
      "get": {
        "operationId": "getIntegrationStatus",
        "security": [{ "deviceToken": [] }],
        "responses": {
          "200": {
            "description": "Subscription and compatibility discovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationStatusResponse"
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "reportIntegrationStatus",
        "description": "Report current HA runtime readiness or a requested replan failure, and read status back. The response is the same discovery document the GET returns.",
        "security": [{ "deviceToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/ReplanFailureRequest" },
                  { "$ref": "#/components/schemas/RuntimeStatusRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription and compatibility discovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationStatusResponse"
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/integration-tariff": {
      "get": {
        "operationId": "getIntegrationTariff",
        "security": [{ "deviceToken": [] }],
        "responses": {
          "200": {
            "description": "Effective tariff catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectSuccessResponse"
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/integration-prices": {
      "get": {
        "operationId": "getIntegrationPrices",
        "security": [{ "deviceToken": [] }],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "All-in supplier prices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectSuccessResponse"
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/ha-energy-ingest": {
      "post": {
        "operationId": "ingestDailyEnergy",
        "security": [{ "deviceToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyEnergyIngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted rows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectSuccessResponse"
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/energy-optimisation-ingest": {
      "post": {
        "operationId": "ingestEnergyOptimisation",
        "security": [{ "deviceToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimisationIngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted telemetry and optional generated plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimisationIngestResponse"
                }
              }
            }
          },
          "426": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/energy-optimisation-plan-ack": {
      "post": {
        "operationId": "acknowledgeEnergyOptimisationPlan",
        "security": [{ "deviceToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanAcknowledgementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectSuccessResponse"
                }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "shs_<64 hex>"
      }
    },
    "responses": {
      "Error": {
        "description": "Versioned machine-readable error",
        "headers": { "X-Request-ID": { "schema": { "type": "string" } } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "RuntimeStatusRequest": {
        "type": "object",
        "required": [
          "api_version",
          "runtime"
        ],
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": 1
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "plan_id",
              "state",
              "reason",
              "binding_until",
              "valid_until",
              "recovering",
              "retry_at",
              "last_error"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "plan_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "state": {
                "enum": [
                  "unavailable",
                  "disabled",
                  "not_configured",
                  "expired",
                  "invalid",
                  "advisory_only",
                  "ready",
                  "incomplete",
                  "infeasible"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "binding_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "valid_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "retry_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "recovering": {
                "type": "boolean"
              },
              "last_error": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            }
          }
        }
      },
      "RequestId": { "type": "string", "minLength": 8, "maxLength": 128 },
      "ApiSuccess": {
        "type": "object",
        "required": ["api_version", "request_id", "ok", "data"],
        "properties": {
          "api_version": { "const": 1 },
          "request_id": { "$ref": "#/components/schemas/RequestId" },
          "ok": { "const": true },
          "data": {}
        },
        "additionalProperties": true,
        "description": "Top-level data aliases are temporarily accepted during the documented reader-first rollout."
      },
      "ErrorInfo": {
        "type": "object",
        "required": ["code", "message", "path", "details", "retryable"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "details": {},
          "retryable": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["api_version", "request_id", "ok", "error", "error_info"],
        "properties": {
          "api_version": { "const": 1 },
          "request_id": { "$ref": "#/components/schemas/RequestId" },
          "ok": { "const": false },
          "error": {
            "type": "string",
            "description": "Temporary v0 alias for error_info.code."
          },
          "error_info": { "$ref": "#/components/schemas/ErrorInfo" }
        },
        "additionalProperties": true
      },
      "PairDeviceRequest": {
        "type": "object",
        "required": ["code", "device_name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z2-9]{8}$" },
          "device_name": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "additionalProperties": false
      },
      "PairDeviceData": {
        "type": "object",
        "required": ["device_token", "customer_id", "home_id"],
        "properties": {
          "device_token": { "type": "string", "pattern": "^shs_[0-9a-f]{64}$" },
          "customer_id": { "type": "string", "format": "uuid" },
          "home_id": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": true
      },
      "PairDeviceResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiSuccess" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/PairDeviceData" }
            }
          }
        ]
      },
      "IntegrationStatusData": {
        "type": "object",
        "required": [
          "api_version",
          "supported_snapshot_schema_versions",
          "supported_plan_schema_versions",
          "minimum_snapshot_schema_version",
          "minimum_plan_schema_version",
          "latest_plan_request_id",
          "pending_replan_request_id",
          "subscription_active",
          "home_id",
          "server_time"
        ],
        "properties": {
          "api_version": { "const": 1 },
          "supported_snapshot_schema_versions": { "const": [5, 6, 7] },
          "supported_plan_schema_versions": { "const": [5, 6, 7] },
          "minimum_snapshot_schema_version": { "const": 5 },
          "minimum_plan_schema_version": { "const": 5 },
          "latest_plan_request_id": {
            "oneOf": [
              { "$ref": "#/components/schemas/RequestId" },
              { "type": "null" }
            ]
          },
          "pending_replan_request_id": {
            "description": "A replan the household has asked for and not yet been given. The device answers it by pushing a snapshot to /energy-optimisation-ingest carrying this id.",
            "type": ["string", "null"],
            "format": "uuid"
          },
          "subscription_active": { "type": "boolean" },
          "subscription_expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "customer_name": { "type": ["string", "null"] },
          "home_id": { "type": "string", "format": "uuid" },
          "server_time": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "IntegrationStatusResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiSuccess" },
          {
            "type": "object",
            "properties": {
          "runtime_received": { "type": ["boolean", "null"], "description": "True only when this request stored the runtime report; false for ignored reports, null for other status requests." },
              "data": { "$ref": "#/components/schemas/IntegrationStatusData" }
            }
          }
        ]
      },
      "ObjectSuccessResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiSuccess" },
          { "type": "object", "properties": { "data": { "type": "object" } } }
        ]
      },
      "DailyEnergyIngestRequest": {
        "type": "object",
        "required": ["readings", "calculations", "supplier_costs"],
        "properties": {
          "readings": {
            "type": "array",
            "maxItems": 500,
            "items": { "type": "object" }
          },
          "calculations": {
            "type": "array",
            "maxItems": 240,
            "items": { "type": "object" }
          },
          "supplier_costs": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      },
      "SnapshotCommon": {
        "type": "object",
        "required": [
          "schema_version",
          "mode",
          "capabilities",
          "snapshot_id",
          "captured_at",
          "timezone",
          "slot_minutes",
          "slots",
          "sources",
          "pv_calibration",
          "battery",
          "grid",
          "policy",
          "device_models",
          "services",
          "service_requirement_sample_days"
        ],
        "properties": {
          "schema_version": { "type": "integer" },
          "mode": { "const": "live" },
          "snapshot_id": { "type": "string", "format": "uuid" },
          "captured_at": { "type": "string", "format": "date-time" },
          "timezone": { "type": "string", "minLength": 1 },
          "slot_minutes": { "const": 15 },
          "capabilities": { "type": "object" },
          "slots": {
            "type": "array",
            "minItems": 4,
            "maxItems": 288,
            "items": { "type": "object" }
          },
          "sources": { "type": "object" },
          "pv_calibration": { "type": "object" },
          "battery": { "type": ["object", "null"] },
          "ev_battery": { "type": ["object", "null"] },
          "pool": { "type": ["object", "null"] },
          "grid": { "type": "object" },
          "policy": { "type": "object" },
          "device_models": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "object" }
          },
          "services": { "type": "array", "items": { "type": "object" } },
          "service_requirement_sample_days": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "additionalProperties": true
      },
      "SnapshotV5": {
        "allOf": [
          { "$ref": "#/components/schemas/SnapshotCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 5 } }
          }
        ]
      },
      "SnapshotV7": {
        "allOf": [
          { "$ref": "#/components/schemas/SnapshotCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 7 } }
          }
        ]
      },
      "SnapshotV6": {
        "allOf": [
          { "$ref": "#/components/schemas/SnapshotCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 6 } }
          }
        ]
      },
      "OptimisationIngestRequest": {
        "type": "object",
        "properties": {
          "equipment": { "type": "object", "required": ["battery"], "properties": { "battery": { "type": "boolean" } }, "additionalProperties": false },
          "api_version": { "const": 1 },
          "accepted_plan_schema_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": [5, 6, 7] }
          },
          "integration_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "actual_slots": {
            "type": "array",
            "maxItems": 288,
            "items": { "type": "object" }
          },
          "devices": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "object" }
          },
          "thermal_slots": {
            "type": "array",
            "maxItems": 288,
            "items": { "type": "object" }
          },
          "price_slots": {
            "type": "array",
            "maxItems": 2880,
            "items": { "type": "object" }
          },
          "pool_slots": {
            "type": "array",
            "maxItems": 288,
            "items": { "type": "object" }
          },
          "device_inventory_complete": { "type": "boolean" },
          "replan_request_id": {
            "description": "The pending_replan_request_id this push answers. Only meaningful with a snapshot, because only a generated plan can complete a request.",
            "type": "string",
            "format": "uuid"
          },
          "snapshot": {
            "oneOf": [
              { "$ref": "#/components/schemas/SnapshotV5" },
              { "$ref": "#/components/schemas/SnapshotV6" },
              { "$ref": "#/components/schemas/SnapshotV7" }
            ]
          }
        },
        "dependentRequired": {
          "replan_request_id": ["snapshot"],
          "api_version": [
            "accepted_plan_schema_versions",
            "integration_version"
          ],
          "accepted_plan_schema_versions": [
            "api_version",
            "integration_version"
          ],
          "integration_version": [
            "api_version",
            "accepted_plan_schema_versions"
          ]
        },
        "additionalProperties": false
      },
      "PlanCommon": {
        "type": "object",
        "required": [
          "schema_version",
          "mode",
          "model_version",
          "decision_diagnostics_version",
          "plan_id",
          "snapshot_id",
          "issued_at",
          "valid_until",
          "binding_until",
          "slot_minutes",
          "status",
          "price_outlook",
          "battery_value_curve",
          "services",
          "device_models",
          "plans"
        ],
        "properties": {
          "schema_version": { "type": "integer" },
          "mode": { "const": "live" },
          "model_version": { "type": "string", "minLength": 1 },
          "decision_diagnostics_version": {
            "const": 2,
            "description": "Independent version of additive, non-executable decision evidence. Version 2 adds the exact derived home-battery curve; absent on plans issued before marginal-value-planner-v11."
          },
          "plan_id": { "type": "string", "format": "uuid" },
          "snapshot_id": { "type": "string", "format": "uuid" },
          "issued_at": { "type": "string", "format": "date-time" },
          "valid_until": { "type": "string", "format": "date-time" },
          "binding_until": { "type": "string", "format": "date-time" },
          "slot_minutes": { "const": 15 },
          "status": { "enum": ["ready", "incomplete", "infeasible"] },
          "services": { "type": "array", "items": { "type": "object" } },
          "device_models": { "type": "array", "items": { "type": "object" } },
          "price_outlook": { "$ref": "#/components/schemas/ResolvedPriceOutlookV1" },
          "battery_value_curve": {
            "oneOf": [
              { "$ref": "#/components/schemas/BatteryValueCurveDiagnosticV1" },
              { "type": "null" }
            ]
          },
          "plans": {
            "type": "object",
            "required": ["baseline", "priority", "cost"],
            "properties": {
              "baseline": { "$ref": "#/components/schemas/GeneratedPlan" },
              "priority": { "$ref": "#/components/schemas/GeneratedPlan" },
              "cost": { "$ref": "#/components/schemas/GeneratedPlan" }
            }
          }
        },
        "additionalProperties": true
      },
      "ResolvedPriceOutlookV1": {
        "type": "object",
        "required": [
          "shaped", "observed_days", "effective_days",
          "level_sek_per_kwh", "shadow_import_sek_per_kwh"
        ],
        "properties": {
          "shaped": { "type": "boolean" },
          "observed_days": { "type": "integer", "minimum": 0 },
          "effective_days": { "type": "number", "minimum": 0 },
          "level_sek_per_kwh": { "type": ["number", "null"] },
          "shadow_import_sek_per_kwh": {
            "type": "array",
            "minItems": 1,
            "maxItems": 288,
            "items": { "type": "number" },
            "description": "Exact unrounded all-in import value used for each horizon quarter; supplying it as the fourth planner argument bypasses price-shape estimation for deterministic replay."
          }
        },
        "additionalProperties": false
      },
      "BatteryValueCurveDiagnosticV1": {
        "type": "object",
        "required": [
          "schema_version", "curve", "state_basis", "initial_state_kwh",
          "usable_capacity_kwh", "covering_window", "curve_input"
        ],
        "properties": {
          "schema_version": { "const": 1 },
          "curve": {
            "type": "object",
            "required": ["unit", "points"],
            "properties": {
              "unit": { "const": "kwh" },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["at", "sek_per_unit"],
                  "properties": {
                    "at": { "type": "number", "minimum": 0 },
                    "sek_per_unit": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "state_basis": { "const": "usable_kwh_above_min_soc" },
          "initial_state_kwh": { "type": "number", "minimum": 0 },
          "usable_capacity_kwh": { "type": "number", "minimum": 0 },
          "covering_window": {
            "type": "array",
            "maxItems": 288,
            "items": {
              "type": "object",
              "required": [
                "start", "import_price_sek_per_kwh",
                "residual_load_ac_kwh", "battery_energy_kwh"
              ],
              "properties": {
                "start": { "type": "string", "format": "date-time" },
                "import_price_sek_per_kwh": { "type": "number" },
                "residual_load_ac_kwh": { "type": "number", "minimum": 0 },
                "battery_energy_kwh": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "curve_input": {
            "type": "object",
            "required": [
              "future_surplus_kwh", "usable_kwh", "round_trip_efficiency",
              "degradation_sek_per_kwh", "expected_draw_kwh"
            ],
            "properties": {
              "future_surplus_kwh": { "type": "number", "minimum": 0 },
              "usable_kwh": { "type": "number", "minimum": 0 },
              "round_trip_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "degradation_sek_per_kwh": { "type": "number", "minimum": 0 },
              "expected_draw_kwh": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "GeneratedPlan": {
        "type": "object",
        "required": ["slots"],
        "properties": {
          "slots": {
            "type": "array",
            "maxItems": 288,
            "items": { "$ref": "#/components/schemas/PlannedSlot" }
          }
        },
        "additionalProperties": true
      },
      "PlannedSlot": {
        "type": "object",
        "properties": {
          "decision": { "$ref": "#/components/schemas/QuarterDecisionV1" }
        },
        "additionalProperties": true
      },
      "QuarterDecisionV1": {
        "type": "object",
        "required": ["schema_version", "store_allocations", "battery", "grid_balance"],
        "properties": {
          "schema_version": { "const": 1 },
          "store_allocations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DispatchAllocationDiagnosticV1" }
          },
          "battery": {
            "oneOf": [
              { "$ref": "#/components/schemas/BatteryDecisionDiagnosticV1" },
              { "type": "null" }
            ]
          },
          "grid_balance": { "$ref": "#/components/schemas/GridBalanceDiagnosticV1" }
        },
        "additionalProperties": false
      },
      "DispatchAllocationDiagnosticV1": {
        "type": "object",
        "required": [
          "store_key", "direction", "trigger", "allocation_order",
          "run_start_index", "run_slots", "power_w", "state_before",
          "state_after", "state_unit", "retention_factor",
          "average_value_sek_per_kwh", "energy_cost_sek_per_kwh",
          "wear_cost_sek_per_kwh", "start_cost_sek", "net_value_sek",
          "run_net_value_sek", "solar_w", "grid_w", "discharge_destination"
        ],
        "properties": {
          "store_key": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["charge", "discharge"] },
          "trigger": { "enum": ["economic_winner", "minimum_run_continuation"] },
          "allocation_order": { "type": "integer", "minimum": 1 },
          "run_start_index": { "type": "integer", "minimum": 0, "maximum": 287 },
          "run_slots": { "type": "integer", "minimum": 1, "maximum": 288 },
          "power_w": { "type": "number", "minimum": 0 },
          "state_before": { "type": "number" },
          "state_after": { "type": "number" },
          "state_unit": { "type": "string", "minLength": 1 },
          "retention_factor": { "type": "number", "minimum": 0 },
          "average_value_sek_per_kwh": { "type": "number" },
          "energy_cost_sek_per_kwh": { "type": "number" },
          "wear_cost_sek_per_kwh": { "type": "number", "minimum": 0 },
          "start_cost_sek": { "type": "number", "minimum": 0 },
          "net_value_sek": { "type": "number" },
          "run_net_value_sek": { "type": "number" },
          "solar_w": { "type": "number", "minimum": 0 },
          "grid_w": { "type": "number", "minimum": 0 },
          "discharge_destination": {
            "type": ["string", "null"],
            "enum": ["load", "export", "mixed", null]
          }
        },
        "additionalProperties": false
      },
      "BatteryDecisionDiagnosticV1": {
        "type": "object",
        "required": [
          "action", "reason", "state_before", "state_after", "state_unit",
          "comparison_power_w", "power_w", "comparison_price_sek_per_kwh",
          "stored_value_sek_per_kwh", "wear_cost_sek_per_kwh", "net_value_sek"
        ],
        "properties": {
          "action": { "enum": ["charge", "discharge", "hold"] },
          "reason": {
            "enum": [
              "profitable_charge", "profitable_discharge",
              "retained_value_exceeds_import", "charge_value_below_export",
              "state_floor", "state_ceiling", "future_state_constraint",
              "load_added_after_dispatch", "balanced"
            ]
          },
          "state_before": { "type": "number" },
          "state_after": { "type": "number" },
          "state_unit": { "type": "string", "minLength": 1 },
          "comparison_power_w": { "type": "number", "minimum": 0 },
          "power_w": { "type": "number", "minimum": 0 },
          "comparison_price_sek_per_kwh": { "type": ["number", "null"] },
          "stored_value_sek_per_kwh": { "type": ["number", "null"] },
          "wear_cost_sek_per_kwh": { "type": "number", "minimum": 0 },
          "net_value_sek": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      },
      "GridBalanceDiagnosticV1": {
        "type": "object",
        "required": [
          "load_w", "pv_w", "battery_charge_w", "battery_discharge_w",
          "residual_w", "direction", "power_w", "limit_w", "limit_binding", "reason"
        ],
        "properties": {
          "load_w": { "type": "number", "minimum": 0 },
          "pv_w": { "type": "number", "minimum": 0 },
          "battery_charge_w": { "type": "number", "minimum": 0 },
          "battery_discharge_w": { "type": "number", "minimum": 0 },
          "residual_w": { "type": "number" },
          "direction": { "enum": ["import", "export", "balanced"] },
          "power_w": { "type": "number", "minimum": 0 },
          "limit_w": { "type": "number", "minimum": 0 },
          "limit_binding": { "type": "boolean" },
          "reason": { "enum": ["residual_after_dispatch", "import_limit", "export_limit", "balanced"] }
        },
        "additionalProperties": false
      },
      "PlanV5": {
        "allOf": [
          { "$ref": "#/components/schemas/PlanCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 5 } }
          }
        ]
      },
      "DeviceCommandV7": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "reason"
            ],
            "properties": {
              "type": {
                "const": "unavailable"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "target_c",
              "minimum_c",
              "maximum_c"
            ],
            "properties": {
              "type": {
                "const": "setpoint"
              },
              "target_c": {
                "type": "number",
                "minimum": 5,
                "maximum": 35
              },
              "minimum_c": {
                "type": "number",
                "minimum": 5,
                "maximum": 35
              },
              "maximum_c": {
                "type": "number",
                "minimum": 5,
                "maximum": 35
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "on_seconds"
            ],
            "properties": {
              "type": {
                "const": "switch_schedule"
              },
              "on_seconds": {
                "enum": [
                  0,
                  900
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "permitted"
            ],
            "properties": {
              "type": {
                "const": "permit_inhibit"
              },
              "permitted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value",
              "unit"
            ],
            "properties": {
              "type": {
                "const": "variable_power"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "unit": {
                "const": "A"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "PlannedSlotV7": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlannedSlot"
          },
          {
            "type": "object",
            "required": [
              "device_commands"
            ],
            "properties": {
              "device_commands": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/DeviceCommandV7"
                }
              }
            }
          }
        ]
      },
      "GeneratedPlanV7": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GeneratedPlan"
          },
          {
            "type": "object",
            "properties": {
              "slots": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PlannedSlotV7"
                }
              }
            }
          }
        ]
      },
      "PlanV7": {
        "allOf": [
          { "$ref": "#/components/schemas/PlanCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 7 }, "plans": {
              "type": "object", "properties": {
                "baseline": { "$ref": "#/components/schemas/GeneratedPlanV7" },
                "priority": { "$ref": "#/components/schemas/GeneratedPlanV7" },
                "cost": { "$ref": "#/components/schemas/GeneratedPlanV7" }
              }
            } }
          }
        ]
      },
      "PlanV6": {
        "allOf": [
          { "$ref": "#/components/schemas/PlanCommon" },
          {
            "type": "object",
            "properties": { "schema_version": { "const": 6 } }
          }
        ]
      },
      "OptimisationIngestData": {
        "type": "object",
        "required": [
          "actual_slots_accepted",
          "thermal_slots_accepted",
          "price_slots_accepted",
          "plan_id",
          "snapshot_id",
          "plan",
          "device_configuration",
          "home_configuration"
        ],
        "properties": {
          "actual_slots_accepted": { "type": "integer", "minimum": 0 },
          "thermal_slots_accepted": { "type": "integer", "minimum": 0 },
          "price_slots_accepted": { "type": "integer", "minimum": 0 },
          "plan_id": { "type": ["string", "null"], "format": "uuid" },
          "snapshot_id": { "type": ["string", "null"], "format": "uuid" },
          "plan": {
            "oneOf": [
              { "$ref": "#/components/schemas/PlanV5" },
              { "$ref": "#/components/schemas/PlanV6" },
              { "$ref": "#/components/schemas/PlanV7" },
              { "type": "null" }
            ]
          },
          "device_configuration": {
            "type": "array",
            "items": { "type": "object", "required": ["key", "planning_role", "planning_choice_at"],
              "properties": { "key": { "type": "string" }, "planning_role": { "enum": ["base_load", "controllable"] },
                "planning_choice_at": { "type": ["string", "null"], "format": "date-time", "description": "Actual website decision; null means never reviewed. Inventory pushes do not change it." } } }
          },
          "home_configuration": {
            "type": "object", "required": ["battery"], "properties": {
              "battery": { "type": "object", "required": ["included", "choice_at"], "properties": {
                "included": { "type": "boolean" }, "choice_at": { "type": ["string", "null"], "format": "date-time" }
              } }
            }
          }
        },
        "additionalProperties": true
      },
      "OptimisationIngestResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiSuccess" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/OptimisationIngestData" }
            }
          }
        ]
      },
      "PlanRejection": {
        "type": "object",
        "required": ["code", "message", "path", "details"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "details": {}
        },
        "additionalProperties": false
      },
      "PlanAcknowledgementRequest": {
        "type": "object",
        "required": [
          "api_version",
          "plan_id",
          "snapshot_id",
          "plan_schema_version",
          "integration_version",
          "outcome",
          "error"
        ],
        "properties": {
          "api_version": { "const": 1 },
          "plan_id": { "type": "string", "format": "uuid" },
          "snapshot_id": { "type": "string", "format": "uuid" },
          "plan_schema_version": { "enum": [5, 6, 7] },
          "integration_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "outcome": { "enum": ["accepted", "rejected"] },
          "error": {
            "oneOf": [
              { "$ref": "#/components/schemas/PlanRejection" },
              { "type": "null" }
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "accepted" } } },
            "then": { "properties": { "error": { "type": "null" } } }
          },
          {
            "if": { "properties": { "outcome": { "const": "rejected" } } },
            "then": {
              "properties": {
                "error": { "$ref": "#/components/schemas/PlanRejection" }
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "ReplanFailureRequest": {
        "type": "object",
        "required": ["replan_request_id", "error"],
        "properties": {
          "replan_request_id": { "type": "string", "format": "uuid" },
          "error": {
            "description": "Why this device could not build a snapshot to plan from, in the household's own terms.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    }
  }
}
